# 复制为 .env 后按需修改。服务端启动时会校验：DATABASE_URL 必填、JWT_SECRET 至少 16 字符。

# ---- 通用 ----
NODE_ENV=development
PORT=3100
TZ=Asia/Shanghai

# 登录态签名密钥，同时用于播放列表代理的 HMAC。生产环境必须换成随机值：
#   openssl rand -hex 32
JWT_SECRET=

# ---- 数据库（本地开发 / 直接 node 启动） ----
# 服务端实际读取的是完整连接串，不再是 DB_HOST/DB_PORT 那一组。
# 密码里的 @ : / ? # 等字符要做 URL 编码。
DATABASE_URL=mysql://root:@127.0.0.1:3306/lcm_video

# 可选：慢查询阈值（毫秒），超过记一条 warn 日志
# SLOW_QUERY_MS=1000
# 可选：日志级别 debug / info / warn / error，默认开发 debug、生产 info
# LOG_LEVEL=debug

# ---- Docker Compose（根目录 docker-compose.yml 使用） ----
# compose 会用这三项给 app 拼出 DATABASE_URL：
#   mysql://DB_USER:DB_PASSWORD@db:3306/DB_NAME
# 因此 DB_PASSWORD 只用字母数字最省事（特殊字符需要 URL 编码，且要保证 db 容器同样能接受）。
# 用 NAS 上已有的数据库时，可删掉 compose 里的 db 服务，并直接改 app 的 DATABASE_URL。
DB_NAME=lcm_video
DB_USER=lcm
DB_PASSWORD=
DB_ROOT_PASSWORD=
