# 复制为 .env 后按需修改。服务端启动时会校验：DATABASE_URL 必填、JWT_SECRET 至少 16 字符。

# ---- 通用 ----
NODE_ENV=development
PORT=3100
TZ=Asia/Shanghai

# 登录态签名密钥，同时用于播放列表代理的 HMAC。生产环境必须换成随机值：
#   openssl rand -hex 32
JWT_SECRET=

# ---- 数据库 ----
# 服务端只读这一条完整连接串，不再使用 DB_HOST/DB_PORT 那一组。
# 密码里的 @ : / ? # 等字符要做 URL 编码。
#
# 本地开发：
DATABASE_URL=mysql://root:@127.0.0.1:3306/lcm_video
#
# NAS 上部署时改成已有数据库的地址，例如：
#   DATABASE_URL=mysql://lcm:密码@192.168.1.10:3306/lcm_video
#   DATABASE_URL=mysql://lcm:密码@host.docker.internal:3306/lcm_video   # 库装在宿主机
#   DATABASE_URL=mysql://lcm:密码@mariadb:3306/lcm_video                 # 与数据库容器同网络

# 可选：慢查询阈值（毫秒），超过记一条 warn 日志
# SLOW_QUERY_MS=1000
# 可选：日志级别 debug / info / warn / error，默认开发 debug、生产 info
# LOG_LEVEL=debug
