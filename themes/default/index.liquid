{% layout 'layout-side' %}
{% block content %}
<section class="section">
  <div class="section-head">
    <h2>最新更新</h2>
  </div>
  <div class="vod-grid">
    {% for v in vods %}
    {% render 'partials/vod-card', card: v %}
    {% else %}
    <p class="empty-tip">还没有影片，先去后台采集一批。</p>
    {% endfor %}
  </div>
</section>

{% endblock %}
