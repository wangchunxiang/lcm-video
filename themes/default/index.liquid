{% layout 'layout' %}
{% block content %}
<div class="home">
<section class="section">
  <div class="section-head">
    <h2>最新更新</h2>
    <span class="today-count">今日更新 {{ today_count }} 部</span>
  </div>
  <div class="vod-grid">
    {% for v in vods %}
    {% render 'partials/vod-card', card: v %}
    {% else %}
    <p class="empty-tip">暂无影片，稍后再来看看。</p>
    {% endfor %}
  </div>
</section>

{% for block in home_categories %}
<section class="section">
  <div class="section-head">
    <h2>{{ block.name }}</h2>
    <a class="more" href="/list/{{ block.alias }}">更多 &gt;</a>
  </div>
  <div class="vod-grid">
    {% for v in block.vods %}
    {% render 'partials/vod-card', card: v %}
    {% endfor %}
  </div>
</section>
{% endfor %}
</div>
{% endblock %}
