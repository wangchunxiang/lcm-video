{% layout 'layout' %}
{% block content %}
<div class="home">
<section class="section">
  <div class="section-head">
    <a class="section-more" href="/today">
      <h2>今日更新</h2>
      <span class="more-expand">查看更多</span>
      <span class="more-arrow">&gt;</span>
    </a>
    <span class="today-count">共 {{ today_count }} 部</span>
  </div>
  <div class="vod-grid">
    {% for v in vods %}
    {% render 'partials/vod-card', card: v %}
    {% else %}
    <p class="empty-tip">暂无影片，稍后再来看看。</p>
    {% endfor %}
  </div>
</section>

{% for block in home_categories %}
<section class="section">
  <div class="section-head">
    <a class="section-more" href="/list/{{ block.alias }}">
      <h2>{{ block.name }}</h2>
      <span class="more-expand">查看更多</span>
      <span class="more-arrow">&gt;</span>
    </a>
  </div>
  <div class="vod-grid">
    {% for v in block.vods %}
    {% render 'partials/vod-card', card: v %}
    {% endfor %}
  </div>
</section>
{% endfor %}
</div>
{% endblock %}
