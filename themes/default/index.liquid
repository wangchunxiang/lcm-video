{% layout 'layout' %}
{% block content %}
<section class="hero">
  <h1>{{ site.name }}</h1>
  {% if site.subtitle != blank %}<p>{{ site.subtitle }}</p>{% endif %}
</section>

<section class="section">
  <div class="section-head">
    <h2>最新更新</h2>
  </div>
  <div class="vod-grid">
    {% for v in vods %}
    {% render 'partials/vod-card', card: v %}
    {% else %}
    <p class="empty-tip">还没有影片，先去后台采集一批。</p>
    {% endfor %}
  </div>
</section>

<section class="section">
  <div class="section-head">
    <h2>分类导航</h2>
  </div>
  <div class="category-nav">
    {% for item in nav %}
    <div class="category-nav-row">
      <a class="category-nav-title" href="/list/{{ item.alias }}">{{ item.name }}</a>
      <div class="category-nav-links">
        {% for child in item.children %}
        <a href="/list/{{ item.alias }}?type={{ child.alias }}">{{ child.name }}</a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endblock %}
