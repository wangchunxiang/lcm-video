{% layout 'mobile/layout' %}
{% assign intro_text = vod.content | default: vod.intro %}
{% block content %}
<article class="m-detail-hero">
  <div class="m-detail-bg" aria-hidden="true">
    <img src="{{ vod.cover | default: '/assets/img/poster-placeholder.svg' }}" alt="" onerror="this.onerror=null;this.src='/assets/img/poster-placeholder.svg'">
  </div>
  <div class="m-detail-main">
    <img
      class="m-detail-poster"
      src="{{ vod.cover | default: '/assets/img/poster-placeholder.svg' }}"
      alt="{{ vod.name }} 海报"
      onerror="this.onerror=null;this.src='/assets/img/poster-placeholder.svg'"
    >
    <div class="m-detail-info">
      <h1 class="m-detail-title">{{ vod.name }}</h1>
      {% if vod.sub_name != blank %}<p class="m-detail-sub">{{ vod.sub_name }}</p>{% endif %}
      <p class="m-detail-meta">
        {{ vod.year }}{% if vod.area != blank %} · {{ vod.area }}{% endif %}{% if vod.category_name != blank %} · {{ vod.category_name }}{% endif %}
      </p>
      {% if vod.remarks != blank or vod.lang != blank %}
      <div class="m-detail-tags">
        {% if vod.remarks != blank %}<span class="m-tag is-accent">{{ vod.remarks }}</span>{% endif %}
        {% if vod.lang != blank %}<span class="m-tag">{{ vod.lang }}</span>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>
</article>

{% if lines.size > 0 and episodes.size > 0 %}
<div class="m-detail-cta">
  <a class="m-btn m-btn-primary m-btn-block" data-hero-play href="/play/{{ vod.id }}/{{ lines.first.id }}/1">立即播放</a>
  <p class="m-detail-note">{{ current_line.name }} · 共 {{ episodes.size }} 集</p>
</div>
{% endif %}

{% if intro_text != blank %}
<details class="m-intro">
  <summary>剧情简介</summary>
  <div class="m-intro-bd">{{ intro_text | escape | newline_to_br }}</div>
</details>
{% endif %}

{% if vod.director != blank or vod.writer != blank or vod.actor != blank %}
<dl class="m-facts">
  <div class="m-fact"><dt>导演</dt><dd>{{ vod.director | default: '—' }}</dd></div>
  <div class="m-fact"><dt>编剧</dt><dd>{{ vod.writer | default: '—' }}</dd></div>
  <div class="m-fact"><dt>演员</dt><dd>{{ vod.actor | default: '—' }}</dd></div>
</dl>
{% endif %}

{% if episodes.size > 0 %}
<section class="m-ep-section">
  <div class="m-ep-head">
    <h2>选集</h2>
    <button type="button" class="m-sort" data-ep-sort>排序</button>
  </div>
  {% if line_tabs.size > 1 %}
  <div class="m-lines">
    {% for l in line_tabs %}
    <a class="m-pill{% if l.id == current_line_id %} is-on{% endif %}" href="{{ l.href }}">{{ l.name }} <i>{{ l.total }}</i></a>
    {% endfor %}
  </div>
  {% endif %}
  <div class="m-ep-grid">
    {% for item in episodes %}
    <a class="m-ep" href="/play/{{ vod.id }}/{{ current_line_id }}/{{ item.index }}" title="{{ item.name }}">{{ item.name }}</a>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}

{% block scripts %}
<script type="application/json" id="ep-groups" data-vod="{{ vod_id }}" data-line="{{ current_line_id }}">{{ episode_json }}</script>
{% endblock %}
