{% layout 'mobile/layout' %}
{% block content %}
<section class="m-hero">
  <div class="m-hero-cover">
    <img
      src="{{ vod.cover | default: '/assets/img/poster-placeholder.svg' }}"
      alt="{{ vod.name }}"
      onerror="this.onerror=null;this.src='/assets/img/poster-placeholder.svg'"
    >
  </div>
  <div class="m-hero-info">
    <h1 class="m-hero-title">{{ vod.name }}</h1>
    {% if vod.sub_name != blank %}<p class="m-hero-sub">{{ vod.sub_name }}</p>{% endif %}
    <p class="m-hero-meta">
      {{ vod.year }}{% if vod.area != blank %} · {{ vod.area }}{% endif %}{% if vod.category_name != blank %} · {{ vod.category_name }}{% endif %}{% if vod.lang != blank %} · {{ vod.lang }}{% endif %}
    </p>
    {% if vod.remarks != blank %}<p class="m-hero-remark">{{ vod.remarks }}</p>{% endif %}
  </div>
</section>

{% if lines.size > 0 %}
<div class="m-hero-actions">
  <a class="m-btn m-btn-primary m-btn-block" href="/play/{{ vod.id }}/{{ lines.first.id }}/1">立即播放</a>
</div>
{% endif %}

<section class="m-sec m-sec-flush">
  <details class="m-intro">
    <summary>剧情简介</summary>
    <div class="m-intro-bd">{{ vod.content | default: vod.intro | escape | newline_to_br }}</div>
  </details>
  <div class="m-fields">
    <div class="m-field"><span>导演</span><b>{{ vod.director | default: '—' }}</b></div>
    <div class="m-field"><span>编剧</span><b>{{ vod.writer | default: '—' }}</b></div>
    <div class="m-field"><span>演员</span><b>{{ vod.actor | default: '—' }}</b></div>
  </div>
</section>

{% if line_tabs.size > 0 %}
<section class="m-sec">
  <div class="m-ep-head">
    <h2>播放列表</h2>
    <button type="button" class="m-sort" data-ep-sort>正序</button>
  </div>
  <div class="m-lines m-lines-tabs">
    {% for line in line_tabs %}
    <button type="button" class="m-pill{% if line.id == current_line_id %} is-on{% endif %}" data-ep-tab="{{ line.id }}">{{ line.name }} <i>{{ line.total }}</i></button>
    {% endfor %}
  </div>
  {% for line in line_tabs %}
  <div class="ep-panel m-ep-panel{% if line.id == current_line_id %} is-active{% endif %}" data-ep-panel="{{ line.id }}">
    {% if line.total > 0 %}
    <div class="episode-grid m-ep-grid">
      {% for ep in line.episodes %}
      <a class="m-ep" href="/play/{{ vod.id }}/{{ line.id }}/{{ ep.index }}" title="{{ ep.name }}">{{ ep.name }}</a>
      {% endfor %}
    </div>
    {% else %}
    <p class="m-empty">该线路暂无剧集</p>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}
{% endblock %}
