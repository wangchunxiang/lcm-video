{% assign reset = filter | with_type: '' | with_year: '' | with_sort: 'time' %}
{% assign type_all = filter | with_type: '' %}
{% assign year_all = filter | with_year: '' %}
<div class="m-sheet" id="filter-sheet" data-sheet aria-hidden="true">
  <div class="m-sheet-mask" data-sheet-close></div>
  <div class="m-sheet-body" role="dialog" aria-modal="true" aria-label="筛选">
    <div class="m-sheet-grab"></div>
    <div class="m-sheet-head">
      <span class="m-sheet-title">筛选</span>
      <button type="button" class="m-sheet-close" data-sheet-close>关闭</button>
    </div>
    <div class="m-sheet-content">
      <div class="m-filter">
        {% if types.size > 0 %}
        <div class="m-filter-row">
          <span class="m-filter-label">类型</span>
          <div class="m-chips">
            <a class="m-chip{% if filter.type == '' %} is-on{% endif %}" href="{{ base | page_url: type_all, 1 }}">全部</a>
            {% for t in types %}
            {% assign f = filter | with_type: t.alias %}
            <a class="m-chip{% if filter.type == t.alias %} is-on{% endif %}" href="{{ base | page_url: f, 1 }}">{{ t.name }}</a>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {% if years.size > 0 %}
        <div class="m-filter-row">
          <span class="m-filter-label">年份</span>
          <div class="m-chips">
            <a class="m-chip{% if filter.year == '' %} is-on{% endif %}" href="{{ base | page_url: year_all, 1 }}">全部</a>
            {% for y in years %}
            {% assign fy = filter | with_year: y %}
            <a class="m-chip{% if filter.year == y %} is-on{% endif %}" href="{{ base | page_url: fy, 1 }}">{{ y }}</a>
            {% endfor %}
          </div>
        </div>
        {% endif %}

        <div class="m-filter-row">
          <span class="m-filter-label">排序</span>
          <div class="m-chips">
            {% assign fs_time = filter | with_sort: 'time' %}
            {% assign fs_new = filter | with_sort: 'new' %}
            <a class="m-chip{% if filter.sort == 'time' %} is-on{% endif %}" href="{{ base | page_url: fs_time, 1 }}">最近更新</a>
            <a class="m-chip{% if filter.sort == 'new' %} is-on{% endif %}" href="{{ base | page_url: fs_new, 1 }}">最新入库</a>
          </div>
        </div>
      </div>
    </div>
    <div class="m-sheet-foot">
      <a class="m-btn" href="{{ base | page_url: reset, 1 }}">重置</a>
      <button type="button" class="m-btn m-btn-primary" data-sheet-close>完成</button>
    </div>
  </div>
</div>
