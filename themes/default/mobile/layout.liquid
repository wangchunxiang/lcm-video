<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
{% if meta.noindex %}<meta name="robots" content="noindex, nofollow">{% else %}<meta name="robots" content="index, follow">{% endif %}
{% if meta.canonical != blank %}<link rel="canonical" href="{{ meta.canonical }}">{% endif %}
<meta name="theme-color" content="#0A0C0F">
{% if site.favicon != blank %}
<link rel="icon" href="{{ site.favicon }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ site.favicon }}">
{% else %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset }}">
{% endif %}
<link rel="manifest" href="/site.webmanifest">
<link rel="stylesheet" href="{{ 'mobile.css' | asset }}">
</head>
<body class="{% block body_class %}{% endblock %}">
<header class="m-header">
  <a class="m-brand" href="/">
    <img class="m-brand-icon" src="{{ 'img/logo.png' | asset }}" alt="" width="28" height="28">
    <span class="m-brand-name">{{ site.name }}</span>
  </a>
  <a class="m-icon-btn" href="/search" aria-label="搜索">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
  </a>
</header>

{% block top %}{% endblock %}

<main class="m-main">
{% block content %}{% endblock %}
</main>

<footer class="m-footer">
  <p class="m-footer-brand">{{ site.name }}</p>
  {% if site.disclaimer != blank %}<p class="m-footer-note">{{ site.disclaimer }}</p>{% endif %}
</footer>

{% block scripts %}{% endblock %}
<script src="{{ 'app.js' | asset }}" defer></script>
<script src="{{ 'mobile.js' | asset }}" defer></script>
</body>
</html>
