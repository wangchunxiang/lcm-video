{% layout 'mobile/layout' %}
{% block content %}
<section class="m-404">
  <div class="m-404-code">{{ status | default: 404 }}</div>
  <p class="m-404-msg">{{ message | default: '页面不存在或已被移除' }}</p>
  <div class="m-404-actions">
    <a class="m-btn m-btn-primary" href="/">回到首页</a>
    <a class="m-btn" href="javascript:history.back()">上一页</a>
  </div>
  {% if nav.size > 0 %}
  <div class="m-404-nav">
    {% for item in nav %}
    <a class="m-chip" href="/list/{{ item.alias }}">{{ item.name }}</a>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endblock %}
