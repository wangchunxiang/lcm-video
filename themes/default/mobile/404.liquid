{% layout 'mobile/layout' %}
{% block content %}
<section class="m-404">
  <p class="m-404-code">404</p>
  <p class="m-404-msg">页面不存在或已被移除。</p>
  <div class="m-404-actions">
    <a class="m-btn m-btn-primary" href="/">返回首页</a>
    <a class="m-btn" href="/search">搜索影片</a>
  </div>
  <nav class="m-404-nav" aria-label="分类导航">
    {% for item in nav %}
    <a class="m-chip" href="/list/{{ item.alias }}">{{ item.name }}</a>
    {% endfor %}
  </nav>
</section>
{% endblock %}
