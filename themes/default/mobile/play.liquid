{% layout 'mobile/layout' %}
{% assign play_base = '/play/' | append: vod.id | append: '/' | append: line.id %}
{% assign prev_ep = current_ep | minus: 1 %}
{% block body_class %}m-immersive{% endblock %}

{% block top %}
<div class="m-stage">
  <div class="m-player-wrap">
    {% if iframe_url != blank %}
    <iframe
      src="{{ iframe_url }}"
      allowfullscreen
      allow="autoplay; fullscreen; encrypted-media"
      frameborder="0"
      scrolling="no"
    ></iframe>
    {% else %}
    <div
      id="player"
      class="m-player-box"
      data-src="{{ play_url }}"
      data-hls="{% if is_hls %}1{% else %}0{% endif %}"
      data-autoplay="{% if autoplay %}1{% else %}0{% endif %}"
      data-autonext="{% if autonext %}1{% else %}0{% endif %}"
      data-resume="{% if resume %}1{% else %}0{% endif %}"
      data-screenshot="{% if screenshot %}1{% else %}0{% endif %}"
      data-webfullscreen="{% if webfullscreen %}1{% else %}0{% endif %}"
      data-fullscreen="{% if fullscreen %}1{% else %}0{% endif %}"
      data-setting="{% if setting %}1{% else %}0{% endif %}"
      data-lang="zh-cn"
      data-poster="{{ vod.cover | default: '/assets/img/poster-placeholder.svg' }}"
      data-vod-id="{{ vod.id }}"
      data-ep="{{ current_ep }}"
      data-next="{{ next_url }}"
    ></div>
    {% endif %}
  </div>
  <a class="m-stage-back" href="/detail/{{ vod.id }}" aria-label="返回详情">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
  </a>
</div>
{% endblock %}

{% block content %}
<section class="m-play-head">
  <h1 class="m-play-title">{{ vod.name }}</h1>
  <p class="m-play-sub">{{ current_ep_name }}{% if line.name != blank %} · {{ line.name }}{% endif %}</p>

  <div class="m-play-actions">
    {% if prev_ep >= 1 %}
    <a class="m-btn" data-m-prev href="{{ play_base }}/{{ prev_ep }}">上一集</a>
    {% else %}
    <span class="m-btn is-off" data-m-prev>上一集</span>
    {% endif %}
    <button type="button" class="m-btn m-btn-primary" data-sheet-open="eps-sheet">
      选集 <span data-m-count>共 {{ episodes.size }} 集</span>
    </button>
    {% if next_url != blank %}
    <a class="m-btn" data-m-next href="{{ next_url }}">下一集</a>
    {% else %}
    <span class="m-btn is-off" data-m-next>下一集</span>
    {% endif %}
  </div>

  {% if lines.size > 1 %}
  <div class="m-lines">
    {% for l in lines %}
    <a class="m-pill{% if l.id == line.id %} is-on{% endif %}" data-ep-line="{{ l.id }}" href="/play/{{ vod.id }}/{{ l.id }}/{{ l.ep }}">{{ l.name }}</a>
    {% endfor %}
  </div>
  {% endif %}
</section>

<div class="m-sheet" id="eps-sheet" data-eps-sheet data-sheet aria-hidden="true">
  <div class="m-sheet-mask" data-sheet-close></div>
  <div class="m-sheet-body" role="dialog" aria-modal="true" aria-label="选集">
    <div class="m-sheet-grab"></div>
    <div class="m-sheet-head">
      <span class="m-sheet-title">选集</span>
      <span class="m-sheet-count">{{ line.name }} · 共 {{ episodes.size }} 集</span>
      <button type="button" class="m-sheet-close" data-sheet-close>关闭</button>
    </div>
    <div class="m-sheet-content">
      <div class="m-ep-grid">
        {% for item in episodes %}
        <a class="m-ep{% if item.index == current_ep %} is-on{% endif %}" href="{{ play_base }}/{{ item.index }}" title="{{ item.name }}">{{ item.name }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="ep-groups" data-vod="{{ vod.id }}" data-line="{{ line.id }}" data-ep="{{ current_ep }}">{{ episode_json }}</script>
<script type="application/json" id="line-data">{{ line_data }}</script>
<script type="application/json" id="play-conf">{"autoplay":"{% if autoplay %}1{% else %}0{% endif %}","autonext":"{% if autonext %}1{% else %}0{% endif %}","resume":"{% if resume %}1{% else %}0{% endif %}","screenshot":"{% if screenshot %}1{% else %}0{% endif %}","webfullscreen":"{% if webfullscreen %}1{% else %}0{% endif %}","fullscreen":"{% if fullscreen %}1{% else %}0{% endif %}","setting":"{% if setting %}1{% else %}0{% endif %}","lang":"zh-cn","poster":"","vod_id":"{{ vod.id }}","vod_name":"{{ vod.name | escape }}","site_name":"{{ site.name | escape }}"}</script>
{% endblock %}

{% block scripts %}{% if need_player %}{% if need_hls %}<script src="{{ 'vendor/hls.min.js' | asset }}"></script>{% endif %}<script src="{{ 'vendor/artplayer.min.js' | asset }}"></script>{% endif %}{% endblock %}
