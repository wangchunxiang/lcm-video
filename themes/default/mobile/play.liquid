{% layout 'mobile/layout' %}
{% assign play_base = '/play/' | append: vod.id | append: '/' | append: line.id %}
{% assign prev_ep = current_ep | minus: 1 %}
{% assign next_ep = current_ep | plus: 1 %}
{% block content %}
<div class="m-player-wrap">
  {% if iframe_url != blank %}
  <iframe
    src="{{ iframe_url }}"
    allowfullscreen
    allow="autoplay; fullscreen; encrypted-media"
    frameborder="0"
    scrolling="no"
  ></iframe>
  {% else %}
  <div
    id="player"
    class="player-box"
    data-src="{{ play_url }}"
    data-hls="{% if is_hls %}1{% else %}0{% endif %}"
    data-autoplay="{% if autoplay %}1{% else %}0{% endif %}"
    data-autonext="{% if autonext %}1{% else %}0{% endif %}"
    data-resume="{% if resume %}1{% else %}0{% endif %}"
    data-screenshot="{% if screenshot %}1{% else %}0{% endif %}"
    data-webfullscreen="{% if webfullscreen %}1{% else %}0{% endif %}"
    data-fullscreen="{% if fullscreen %}1{% else %}0{% endif %}"
    data-setting="{% if setting %}1{% else %}0{% endif %}"
    data-lang="zh-cn"
    data-poster="{{ vod.cover | default: '/assets/img/poster-placeholder.svg' }}"
    data-vod-id="{{ vod.id }}"
    data-ep="{{ current_ep }}"
    data-next="{{ next_url }}"
  ></div>
  {% endif %}
</div>

<section class="m-play-head">
  <h1 class="m-play-title">{{ vod.name }}</h1>
  <p class="m-play-sub">{{ current_ep_name }}{% if line.name != blank %} · {{ line.name }}{% endif %}</p>

  <div class="m-play-actions">
    {% if prev_ep >= 1 %}
    <a class="m-btn" href="{{ play_base }}/{{ prev_ep }}">上一集</a>
    {% else %}
    <span class="m-btn is-off">上一集</span>
    {% endif %}
    <button type="button" class="m-btn m-btn-primary" data-open-eps>选集 · 共 {{ episodes.size }} 集</button>
    {% if next_url != blank %}
    <a class="m-btn" href="{{ next_url }}">下一集</a>
    {% else %}
    <span class="m-btn is-off">下一集</span>
    {% endif %}
  </div>

  {% if lines.size > 1 %}
  <div class="m-lines">
    {% for l in lines %}
    <a class="m-pill{% if l.id == line.id %} is-on{% endif %}" href="/play/{{ vod.id }}/{{ l.id }}/{{ l.ep }}">{{ l.name }}</a>
    {% endfor %}
  </div>
  {% endif %}
</section>

<div class="m-sheet" data-eps-sheet aria-hidden="true">
  <div class="m-sheet-mask" data-close-eps></div>
  <div class="m-sheet-body" role="dialog" aria-label="选集">
    <div class="m-sheet-head">
      <span>选集</span>
      <span class="m-sheet-count">{{ line.name }} · 共 {{ episodes.size }} 集</span>
      <button type="button" class="m-sheet-close" data-close-eps>关闭</button>
    </div>
    <div class="ep-panel m-ep-panel is-active">
      <div class="episode-grid m-ep-grid">
        {% for item in episodes %}
        <a class="m-ep ep-w{{ item.width }}{% if item.index == current_ep %} is-on{% endif %}" href="{{ play_base }}/{{ item.index }}" title="{{ item.name }}">{{ item.name }}</a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% endblock %}
{% block scripts %}{% if iframe_url == blank %}{% if is_hls %}<script src="{{ 'vendor/hls.min.js' | asset }}"></script>{% endif %}<script src="{{ 'vendor/artplayer.min.js' | asset }}"></script>{% endif %}{% endblock %}
