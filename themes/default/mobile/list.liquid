{% layout 'mobile/layout' %}
{% assign base = base_url | default: '' %}
{% if base == '' %}{% assign base = '/list/' | append: category.alias %}{% endif %}
{% assign active = 0 %}
{% if filter.type != '' %}{% assign active = active | plus: 1 %}{% endif %}
{% if filter.year != '' %}{% assign active = active | plus: 1 %}{% endif %}
{% if filter.sort != 'time' %}{% assign active = active | plus: 1 %}{% endif %}

{% block top %}
<div class="m-bar">
  <span class="m-bar-title">{{ category.name }}</span>
  <span class="m-bar-count">{{ pagination.total }} 部</span>
  <button
    type="button"
    class="m-bar-btn"
    data-sheet-open="filter-sheet"
    aria-haspopup="dialog"
    aria-controls="filter-sheet"
  >
    筛选
    {% if active > 0 %}<i class="m-dot" aria-hidden="true"></i>{% endif %}
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"></path></svg>
  </button>
</div>
{% endblock %}

{% block content %}
<div class="m-grid" id="m-list">
  {% for v in vods %}
  {% render 'mobile/partials/poster-card', card: v %}
  {% else %}
  <p class="m-empty">该分类下暂无影片。</p>
  {% endfor %}
</div>

{% if pagination.total > 0 %}
{% if pagination.page < pagination.total_pages %}
{% assign next_page = pagination.page | plus: 1 %}
<div class="m-more-wrap">
  <a class="m-more-btn" id="m-more" href="{{ base | page_url: filter, next_page }}">加载更多</a>
</div>
{% else %}
<p class="m-end">已全部加载 · 共 {{ pagination.total }} 部</p>
{% endif %}
{% endif %}

{% render 'mobile/partials/filter-sheet', base: base, filter: filter, types: types, years: years %}
{% endblock %}
