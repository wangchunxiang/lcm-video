{% layout 'layout' %}
{% block content %}
{% assign base = '/list/' | append: category.alias %}
{% assign clear = filter | with_type: '' | with_year: '' %}

<nav class="breadcrumb">
  <a href="/">首页</a>
  <span>/</span>
  <a href="{{ base }}">{{ category.name }}</a>
  {% if filter.type_name != blank %}
  <span>/</span>
  <span>{{ filter.type_name }}</span>
  {% endif %}
</nav>

{% if types.size > 0 or years.size > 0 %}
<div class="filter-block">
{% endif %}
{% if types.size > 0 %}
<div class="filter-row">
  <span class="filter-label">类型</span>
  <a class="filter-item{% if filter.type == '' %} active{% endif %}" href="{{ base | page_url: clear, 1 }}">全部</a>
  {% for t in types %}
  {% assign f = filter | with_type: t.alias %}
  <a class="filter-item{% if filter.type == t.alias %} active{% endif %}" href="{{ base | page_url: f, 1 }}">{{ t.name }}</a>
  {% endfor %}
</div>
{% endif %}

{% if years.size > 0 %}
<div class="filter-row">
  <span class="filter-label">年份</span>
  {% assign fy_all = filter | with_year: '' %}
  <a class="filter-item{% if filter.year == '' %} active{% endif %}" href="{{ base | page_url: fy_all, 1 }}">全部</a>
  {% for y in years %}
  {% assign fy = filter | with_year: y %}
  <a class="filter-item{% if filter.year == y %} active{% endif %}" href="{{ base | page_url: fy, 1 }}">{{ y }}</a>
  {% endfor %}
</div>
{% endif %}

<div class="filter-row">
  <span class="filter-label">排序</span>
  {% assign fs_time = filter | with_sort: 'time' %}
  {% assign fs_new = filter | with_sort: 'new' %}
  <a class="filter-item{% if filter.sort == 'time' %} active{% endif %}" href="{{ base | page_url: fs_time, 1 }}">最近更新</a>
  <a class="filter-item{% if filter.sort == 'new' %} active{% endif %}" href="{{ base | page_url: fs_new, 1 }}">最新入库</a>
</div>
{% if types.size > 0 or years.size > 0 %}
</div>
{% endif %}

<div class="vod-grid">
  {% for v in vods %}
  {% render 'partials/vod-card', card: v %}
  {% else %}
  <p class="empty-tip">这个分类下还没有影片。</p>
  {% endfor %}
</div>

{% render 'partials/pagination', pagination: pagination, base: base, filter: filter %}
{% endblock %}
