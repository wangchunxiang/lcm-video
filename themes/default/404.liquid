{% layout 'layout' %}
{% block content %}
<section class="error-page">
  <h1>{{ status | default: 404 }}</h1>
  <p class="error-message">{{ message | default: '页面不存在或已被移除' }}</p>

  <div class="error-actions">
    <a class="btn-primary" href="/">回到首页</a>
    <a class="btn-ghost" href="javascript:history.back()">返回上一页</a>
  </div>

  {% if nav.size > 0 %}
  <div class="error-nav">
    <span class="error-nav-label">去看看</span>
    {% for item in nav %}
    <a href="/list/{{ item.alias }}">{{ item.name }}</a>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endblock %}
