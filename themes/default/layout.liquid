<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ meta.title }}</title>
<meta name="description" content="{{ meta.description }}">
{% if meta.noindex %}<meta name="robots" content="noindex, nofollow">{% else %}<meta name="robots" content="index, follow">{% endif %}
{% if meta.canonical != blank %}<link rel="canonical" href="{{ meta.canonical }}">{% endif %}
{% if site.favicon != blank %}
<link rel="icon" href="{{ site.favicon }}">
{% else %}
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset }}">
<link rel="icon" type="image/png" sizes="16x16" href="{{ 'favicon-16.png' | asset }}">
<link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset }}">
{% endif %}
<link rel="stylesheet" href="{{ 'style.css' | asset }}">
</head>
<body>
{% render 'partials/header', site: site, nav: nav, current: nav_path, keyword: keyword %}
<main class="container">
{% block content %}{% endblock %}
</main>
{% render 'partials/footer', site: site %}
{% block scripts %}{% endblock %}
<script src="{{ 'app.js' | asset }}" defer></script>
{% if site.stats_code != blank %}{{ site.stats_code }}{% endif %}
</body>
</html>
