{% layout 'layout' %}
{% block content %}
{% assign play_base = '/play/' | append: vod.id | append: '/' | append: line.id %}

<div class="play-wrap">
  <div class="player-shell">
    <div class="player">
    {% if iframe_url != blank %}
    <iframe
      src="{{ iframe_url }}"
      allowfullscreen
      allow="autoplay; fullscreen; encrypted-media"
      frameborder="0"
      scrolling="no"
    ></iframe>
    {% else %}
    <div
      id="player"
      class="player-box"
      data-src="{{ play_url }}"
      data-hls="{% if is_hls %}1{% else %}0{% endif %}"
      data-autoplay="{% if autoplay %}1{% else %}0{% endif %}"
      data-autonext="{% if autonext %}1{% else %}0{% endif %}"
      data-resume="{% if resume %}1{% else %}0{% endif %}"
      data-screenshot="{% if screenshot %}1{% else %}0{% endif %}"
      data-webfullscreen="{% if webfullscreen %}1{% else %}0{% endif %}"
      data-fullscreen="{% if fullscreen %}1{% else %}0{% endif %}"
      data-setting="{% if setting %}1{% else %}0{% endif %}"
      data-lang="zh-cn"
      data-poster=""
      data-vod-id="{{ vod.id }}"
      data-ep="{{ current_ep }}"
      data-next="{{ next_url }}"
    ></div>
    {% endif %}
    </div>
    <div class="player-loading" data-player-loading data-loading-src="/assets/img/loading.webp">
      <span class="player-spin"></span>
      <span>影片加载中…</span>
    </div>
  </div>

  <aside class="play-side">
    <div class="play-side-head">
      <a class="play-side-title" href="/detail/{{ vod.id }}" title="{{ vod.name }}">{{ vod.name }}</a>
      <span class="play-side-ep" data-ep-title>{{ current_ep_name }}</span>
    </div>

    <div class="play-side-lines">
      <div class="line-dd" data-line-dd>
        <button type="button" class="line-dd-btn" data-line-dd-btn aria-haspopup="listbox" aria-expanded="false">
          <span class="line-dd-name" data-line-dd-name>{{ line.name }}</span>
          <span class="n" data-line-dd-count>{{ line.episode_count }} 集</span>
          <span class="chev">{% render 'partials/icon', name: 'chevron-down' %}</span>
        </button>
        <div class="line-dd-panel" data-line-dd-panel hidden role="listbox">
          {% for l in lines %}
          <a class="line-dd-item{% if l.id == line.id %} is-active{% endif %}"
             href="/play/{{ vod.id }}/{{ l.id }}/{{ l.ep }}"
             data-ep-line="{{ l.id }}"
             role="option"
             aria-selected="{% if l.id == line.id %}true{% else %}false{% endif %}"
             title="{{ l.name }}">
            <span>{{ l.name }}</span><span class="n">{{ l.episode_count }} 集</span><span class="ms" data-ms></span>
          </a>
          {% endfor %}
        </div>
      </div>
      <button type="button" class="line-speed" data-line-speed>测速</button>
      <button type="button" class="ep-sort" data-ep-sort>正序</button>
    </div>

    <div class="ep-panel is-active">
      {% if episodes.size > 0 %}
      <div class="ep-scroll">
        <div class="episode-grid">
          {% for item in episodes %}
          <a class="episode-btn{% if item.index == current_ep %} current{% endif %}"
             href="{{ play_base }}/{{ item.index }}" title="{{ item.name }}">{{ item.name }}</a>
          {% endfor %}
        </div>
      </div>
      {% else %}
      <p class="empty-tip">该线路暂无剧集</p>
      {% endif %}
    </div>

    <div class="play-side-nav">
      {% if prev_url != blank %}
      <a href="{{ prev_url }}" data-ep-prev>‹ 上一集</a>
      {% else %}
      <span class="is-off" data-ep-prev>‹ 上一集</span>
      {% endif %}
      {% if next_url != blank %}
      <a href="{{ next_url }}" data-ep-next>下一集 ›</a>
      {% else %}
      <span class="is-off" data-ep-next>下一集 ›</span>
      {% endif %}
    </div>
  </aside>
</div>
<script type="application/json" id="ep-groups" data-vod="{{ vod.id }}" data-line="{{ line.id }}" data-ep="{{ current_ep }}">{{ episode_json }}</script>
<script type="application/json" id="line-data">{{ line_data }}</script>
<script type="application/json" id="play-conf">{"autoplay":"{% if autoplay %}1{% else %}0{% endif %}","autonext":"{% if autonext %}1{% else %}0{% endif %}","resume":"{% if resume %}1{% else %}0{% endif %}","screenshot":"{% if screenshot %}1{% else %}0{% endif %}","webfullscreen":"{% if webfullscreen %}1{% else %}0{% endif %}","fullscreen":"{% if fullscreen %}1{% else %}0{% endif %}","setting":"{% if setting %}1{% else %}0{% endif %}","lang":"zh-cn","poster":"","vod_id":"{{ vod.id }}","vod_name":"{{ vod.name | escape }}","site_name":"{{ site.name | escape }}"}</script>
{% endblock %}
{% block scripts %}{% if need_player %}{% if need_hls %}<script src="{{ 'vendor/hls.min.js' | asset }}"></script>{% endif %}<script src="{{ 'vendor/artplayer.min.js' | asset }}"></script>{% endif %}{% endblock %}
