{% if pagination.total_pages > 1 %}
{% assign prev_page = pagination.page | minus: 1 %}
{% assign next_page = pagination.page | plus: 1 %}
<nav class="pagination" aria-label="分页">
  {% if pagination.page > 1 %}
  <a class="page-btn" href="{{ base | page_url: filter, 1 }}">首页</a>
  <a class="page-btn" href="{{ base | page_url: filter, prev_page }}">上一页</a>
  {% endif %}

  {% assign start = pagination.page | minus: 2 %}
  {% if start < 1 %}{% assign start = 1 %}{% endif %}
  {% assign end = start | plus: 4 %}
  {% if end > pagination.total_pages %}{% assign end = pagination.total_pages %}{% endif %}

  {% for p in (start..end) %}
    {% if p == pagination.page %}
    <span class="page-btn current">{{ p }}</span>
    {% else %}
    <a class="page-btn" href="{{ base | page_url: filter, p }}">{{ p }}</a>
    {% endif %}
  {% endfor %}

  {% if pagination.page < pagination.total_pages %}
  <a class="page-btn" href="{{ base | page_url: filter, next_page }}">下一页</a>
  <a class="page-btn" href="{{ base | page_url: filter, pagination.total_pages }}">尾页</a>
  {% endif %}

  <span class="page-info">共 {{ pagination.total }} 部 / {{ pagination.total_pages }} 页</span>
</nav>
{% endif %}
