<a class="vod-card" href="/detail/{{ card.id }}" title="{{ card.name }}">
  <div class="cover">
    <img
      src="{{ card.cover | default: '/assets/img/poster-placeholder.svg' }}"
      alt="{{ card.name }}"
      loading="lazy"
      onerror="this.onerror=null;this.src='/assets/img/poster-placeholder.svg'"
    >
    {% if card.remarks != blank %}<span class="badge">{{ card.remarks }}</span>{% endif %}
  </div>
  <div class="title">{{ card.name }}</div>
</a>
