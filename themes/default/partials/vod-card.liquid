<a class="vod-card" href="/detail/{{ card.id }}" title="{{ card.name }}">
  <div class="cover">
    {% if card.cover != blank %}
    <img src="{{ card.cover }}" alt="{{ card.name }}" loading="lazy">
    {% else %}
    <span class="no-cover">{{ card.name | truncate_text: 6 }}</span>
    {% endif %}
    {% if card.remarks != blank %}<span class="badge">{{ card.remarks }}</span>{% endif %}
  </div>
  <div class="title">{{ card.name }}</div>
  <div class="meta">
    <span>{{ card.year }}</span>
    {% if card.area != blank %}<span>{{ card.area }}</span>{% endif %}
    {% if card.category_name != blank %}<span>{{ card.category_name }}</span>{% endif %}
  </div>
</a>
