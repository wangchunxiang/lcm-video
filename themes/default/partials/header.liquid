<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/">
      {% if site.logo != blank %}
      <img
        src="{{ site.logo }}"
        alt="{{ site.name }}"
        onerror="this.style.display='none';this.nextElementSibling.style.display='inline'"
      >
      <span class="logo-text" style="display:none">{{ site.name }}</span>
      {% else %}
      <img
        class="logo-icon"
        src="{{ 'img/logo.png' | asset }}"
        alt=""
        width="128" height="128"
        onerror="this.style.display='none'"
      >
      <span class="logo-text">{{ site.name }}</span>
      {% endif %}
    </a>
    <nav class="main-nav">
      <a href="/" class="{% if current == '' %}active{% endif %}">
        {% render 'partials/icon', name: 'home' %}
        <span>首页</span>
      </a>
      {% for item in nav %}
      {% assign nav_icon = '' %}
      {% if item.alias == 'dianying' %}{% assign nav_icon = 'film' %}
      {% elsif item.alias == 'juji' %}{% assign nav_icon = 'tv' %}
      {% elsif item.alias == 'zongyi' %}{% assign nav_icon = 'clapper' %}
      {% elsif item.alias == 'dongman' %}{% assign nav_icon = 'anime' %}
      {% elsif item.name contains '电影' %}{% assign nav_icon = 'film' %}
      {% elsif item.name contains '动漫' %}{% assign nav_icon = 'anime' %}
      {% elsif item.name contains '综艺' %}{% assign nav_icon = 'clapper' %}
      {% elsif item.name contains '剧' %}{% assign nav_icon = 'tv' %}
      {% endif %}
      <a href="/list/{{ item.alias }}" class="{% if current == item.alias %}active{% endif %}">
        {% if nav_icon != '' %}{% render 'partials/icon', name: nav_icon %}{% endif %}
        <span>{{ item.name }}</span>
      </a>
      {% endfor %}
    </nav>
    <form class="search-box" action="/search" method="get">
      <input type="search" name="wd" placeholder="搜索影片" maxlength="50" value="{{ keyword }}" autocomplete="off" spellcheck="false" aria-label="搜索影片">
      <button type="submit" aria-label="搜索">搜索</button>
    </form>
  </div>
</header>
