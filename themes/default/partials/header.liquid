<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="/">
      {% if site.logo != blank %}
      <img src="{{ site.logo }}" alt="{{ site.name }}">
      {% else %}
      <span>{{ site.name }}</span>
      {% endif %}
    </a>
    <nav class="main-nav">
      <a href="/" class="{% if current == '' %}active{% endif %}">首页</a>
      {% for item in nav %}
      <a href="/list/{{ item.alias }}" class="{% if current == item.alias %}active{% endif %}">{{ item.name }}</a>
      {% endfor %}
    </nav>
    <form class="search-box" action="/search" method="get">
      <input type="search" name="wd" placeholder="搜索影片" maxlength="50" value="{{ keyword }}" autocomplete="off" spellcheck="false" aria-label="搜索影片">
      <button type="submit" aria-label="搜索">搜索</button>
    </form>
  </div>
</header>
