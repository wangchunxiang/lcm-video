{% layout 'layout' %}
{% block content %}
<nav class="breadcrumb">
  <a href="/">首页</a>
  <span>/</span>
  {% if vod.parent_alias != blank %}
  <a href="/list/{{ vod.parent_alias }}">{{ vod.parent_name }}</a>
  <span>/</span>
  {% endif %}
  {% if vod.parent_alias and vod.category_alias and vod.category_name %}
  <a href="/list/{{ vod.parent_alias }}?type={{ vod.category_alias }}">{{ vod.category_name }}</a>
  {% elsif vod.category_name %}
  <span>{{ vod.category_name }}</span>
  {% endif %}
  <span>{{ vod.name }}</span>
</nav>

<div class="detail-card">
  <div class="detail-cover-wrap">
    <div class="detail-cover">
      {% if vod.cover != blank %}
      <img src="{{ vod.cover }}" alt="{{ vod.name }}">
      {% else %}
      <div class="no-cover big">{{ vod.name | truncate_text: 8 }}</div>
      {% endif %}
    </div>
  </div>

  <div class="detail-info">
    <div class="d-title">
      <div class="title-row">
        <h1>{{ vod.name }}</h1>
        {% if vod.remarks != blank %}<span class="title-badge">{{ vod.remarks }}</span>{% endif %}
        {% if lines.size > 0 %}<a class="btn-primary btn-play-inline" href="/play/{{ vod.id }}/{{ lines.first.id }}/1">立即播放</a>{% endif %}
      </div>
      {% if vod.sub_name != blank %}<p class="sub-name">{{ vod.sub_name }}</p>{% endif %}
    </div>

    <div class="d-tags">
      {% if vod.category_name != blank %}<span class="cat"><i>分类</i>{{ vod.category_name }}</span>{% endif %}
      <span class="year"><i>年份</i>{{ vod.year }}</span>
      {% if vod.area != blank %}<span class="area"><i>地区</i>{{ vod.area }}</span>{% endif %}
      {% if vod.lang != blank %}<span class="lang"><i>语言</i>{{ vod.lang }}</span>{% endif %}
    </div>

    <dl class="d-fields">
      <div><dt>导演</dt><dd>{% if vod.director != blank %}{{ vod.director }}{% else %}—{% endif %}</dd></div>
      <div><dt>编剧</dt><dd>{% if vod.writer != blank %}{{ vod.writer }}{% else %}—{% endif %}</dd></div>
      <div><dt>演员</dt><dd>{% if vod.actor != blank %}{{ vod.actor }}{% else %}—{% endif %}</dd></div>
      <div class="wide">
        <dt>简介</dt>
        <dd>{{ vod.intro | escape }}{% if vod.content != blank and vod.content != vod.intro %}<a class="intro-link" href="javascript:void(0)" data-intro-float>详情</a>{% endif %}</dd>
      </div>
    </dl>
  </div>
  {% if vod.content != blank and vod.content != vod.intro %}
  <div class="intro-float" data-intro-float-panel>
    <div class="intro-float-hd"><span>剧情简介</span><a class="intro-link" href="javascript:void(0)" data-intro-float>收起</a></div>
    <div class="intro-float-bd">{{ vod.content | escape }}</div>
  </div>
  {% endif %}
</div>

{% if line_tabs.size > 0 %}
<section class="section detail-eps">
  <div class="ep-tabs" role="tablist">
    {% for line in line_tabs %}
    <button type="button" class="ep-tab{% if line.id == current_line_id %} is-active{% endif %}" data-ep-tab="{{ line.id }}">{{ line.name }} <span class="count">{{ line.total }}</span></button>
    {% endfor %}
  </div>
  {% for line in line_tabs %}
  <div class="ep-panel{% if line.id == current_line_id %} is-active{% endif %}" data-ep-panel="{{ line.id }}">
    {% if line.total > 0 %}
    <div class="ep-scroll">
      <div class="episode-grid">
        {% for ep in line.episodes %}
        <a class="ep" href="/play/{{ vod.id }}/{{ line.id }}/{{ ep.index }}">{{ ep.name }}</a>
        {% endfor %}
      </div>
    </div>
    {% else %}
    <p class="empty-tip">该线路还没有剧集</p>
    {% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}
{% endblock %}
