{% layout 'layout' %}
{% block content %}
<nav class="breadcrumb">
  <a href="/">首页</a>
  <span>/</span>
  {% if vod.parent_alias != blank %}
  <a href="/list/{{ vod.parent_alias }}">{{ vod.parent_name }}</a>
  <span>/</span>
  {% endif %}
  {% if vod.parent_alias and vod.category_alias and vod.category_name %}
  <a href="/list/{{ vod.parent_alias }}?type={{ vod.category_alias }}">{{ vod.category_name }}</a>
  {% elsif vod.category_name %}
  <span>{{ vod.category_name }}</span>
  {% endif %}
  <span>{{ vod.name }}</span>
</nav>

<div class="detail-layout">
  <aside class="detail-side">
    <div class="detail-cover">
      {% if vod.cover != blank %}
      <img src="{{ vod.cover }}" alt="{{ vod.name }}">
      {% else %}
      <div class="no-cover big">{{ vod.name | truncate_text: 8 }}</div>
      {% endif %}
    </div>

    {% if lines.size > 0 %}
    <section class="section">
      <h2>播放列表{% if current_line %} <span class="section-count">共 {{ current_line.episode_count }} 集</span>{% endif %}</h2>
      <div class="line-tabs">
        {% for line in lines %}
        <a class="line-tab{% if line.id == current_line.id %} active{% endif %}"
           href="/detail/{{ vod.id }}?line={{ line.id }}">{{ line.name }}
          <span class="count">{{ line.episode_count }}</span>
        </a>
        {% endfor %}
      </div>

      {% if episodes.size > 0 %}
      {% assign play_base = '/play/' | append: vod.id | append: '/' | append: current_line.id %}
      {% assign ep_base = '/detail/' | append: vod.id | append: '?line=' | append: current_line.id %}
      {% render 'partials/episode-list', episodes: episodes, current_ep: 0, play_base: play_base %}

      {% if pagination.total_pages > 1 %}
      <nav class="ep-pager">
        {% if pagination.page > 1 %}
        <a class="ep-page" href="{{ ep_base }}&ep={{ pagination.page | minus: 1 }}">上一页</a>
        {% else %}
        <span class="ep-page disabled">上一页</span>
        {% endif %}
        {% for p in page_numbers %}
        {% if p == 'gap' %}
        <span class="ep-page gap">…</span>
        {% else %}
        <a class="ep-page{% if p == pagination.page %} active{% endif %}" href="{{ ep_base }}&ep={{ p }}">{{ p }}</a>
        {% endif %}
        {% endfor %}
        {% if pagination.page < pagination.total_pages %}
        <a class="ep-page" href="{{ ep_base }}&ep={{ pagination.page | plus: 1 }}">下一页</a>
        {% else %}
        <span class="ep-page disabled">下一页</span>
        {% endif %}
      </nav>
      {% endif %}
      {% endif %}
    </section>
    {% endif %}

  </div>
</div>
{% endblock %}
