{% layout 'layout' %}
{% block content %}
<nav class="breadcrumb">
  <a href="/">首页</a>
  <span>/</span>
  {% if vod.parent_alias != blank %}
  <a href="/list/{{ vod.parent_alias }}">{{ vod.parent_name }}</a>
  <span>/</span>
  {% endif %}
  {% if vod.parent_alias and vod.category_alias and vod.category_name %}
  <a href="/list/{{ vod.parent_alias }}?type={{ vod.category_alias }}">{{ vod.category_name }}</a>
  {% elsif vod.category_name %}
  <span>{{ vod.category_name }}</span>
  {% endif %}
  <span>{{ vod.name }}</span>
</nav>

<section class="detail">
  <div class="detail-cover">
    {% if vod.cover != blank %}
    <img src="{{ vod.cover }}" alt="{{ vod.name }}">
    {% else %}
    <div class="no-cover big">{{ vod.name | truncate_text: 8 }}</div>
    {% endif %}
  </div>

  <div class="detail-info">
    <h1>{{ vod.name }}</h1>
    {% if vod.sub_name != blank %}<p class="sub-name">{{ vod.sub_name }}</p>{% endif %}

    <dl class="info-list">
      {% if vod.category_name != blank %}
      <div>
        <dt>分类</dt>
        <dd>
          {% if vod.parent_alias != blank %}<a href="/list/{{ vod.parent_alias }}">{{ vod.parent_name }}</a> / {% endif %}
          {{ vod.category_name }}
        </dd>
      </div>
      {% endif %}
      <div><dt>年份</dt><dd>{{ vod.year }}</dd></div>
      {% if vod.area != blank %}<div><dt>地区</dt><dd>{{ vod.area }}</dd></div>{% endif %}
      {% if vod.lang != blank %}<div><dt>语言</dt><dd>{{ vod.lang }}</dd></div>{% endif %}
      {% if vod.release_date != blank %}<div><dt>上映</dt><dd>{{ vod.release_date }}</dd></div>{% endif %}
      {% if vod.actor != blank %}<div><dt>演员</dt><dd>{{ vod.actor }}</dd></div>{% endif %}
      {% if vod.director != blank %}<div><dt>导演</dt><dd>{{ vod.director }}</dd></div>{% endif %}
      {% if vod.writer != blank %}<div><dt>编剧</dt><dd>{{ vod.writer }}</dd></div>{% endif %}
      {% if vod.remarks != blank %}<div><dt>状态</dt><dd>{{ vod.remarks }}</dd></div>{% endif %}
    </dl>

    {% if lines.size > 0 %}
    <div class="play-actions">
      <a class="btn-primary" href="/play/{{ vod.id }}/{{ lines.first.id }}/1">立即播放</a>
      {% if episodes.size > 0 %}
      <span class="tip">{{ current_line.name }} · 共 {{ current_line.episode_count }} 集</span>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>

{% if vod.intro != blank %}
<section class="section">
  <h2>剧情简介</h2>
  <p class="intro">{{ vod.intro }}</p>
</section>
{% endif %}

{% if lines.size > 0 %}
<section class="section">
  <h2>播放线路</h2>
  <div class="line-tabs">
    {% for line in lines %}
    <a class="line-tab{% if forloop.first %} active{% endif %}"
       href="/play/{{ vod.id }}/{{ line.id }}/1">{{ line.name }}
      <span class="count">{{ line.episode_count }}</span>
    </a>
    {% endfor %}
  </div>

  {% if episodes.size > 0 %}
  <h3 class="episode-title">{{ current_line.name }} 剧集</h3>
  {% assign play_base = '/play/' | append: vod.id | append: '/' | append: current_line.id %}
  {% render 'partials/episode-list', episodes: episodes, current_ep: 0, play_base: play_base %}
  {% if current_line.episode_count > 50 %}
  <p class="more-link"><a href="{{ play_base }}/1">查看全部 {{ current_line.episode_count }} 集</a></p>
  {% endif %}
  {% endif %}
</section>
{% endif %}

{% if vod.content != blank %}
<section class="section">
  <h2>详细剧情</h2>
  <div class="content-text">{{ vod.content }}</div>
</section>
{% endif %}
{% endblock %}
