{% layout 'layout' %}
{% block content %}
<nav class="breadcrumb">
  <a href="/">首页</a>
  <span>/</span>
  {% if vod.parent_alias != blank %}
  <a href="/list/{{ vod.parent_alias }}">{{ vod.parent_name }}</a>
  <span>/</span>
  {% endif %}
  {% if vod.parent_alias and vod.category_alias and vod.category_name %}
  <a href="/list/{{ vod.parent_alias }}?type={{ vod.category_alias }}">{{ vod.category_name }}</a>
  {% elsif vod.category_name %}
  <span>{{ vod.category_name }}</span>
  {% endif %}
  <span>{{ vod.name }}</span>
</nav>

<div class="detail-card">
  <div class="detail-cover-wrap">
    <div class="detail-cover">
      <img
        src="{{ vod.cover | default: '/assets/img/poster-placeholder.svg' }}"
        alt="{{ vod.name }}"
        onerror="this.onerror=null;this.src='/assets/img/poster-placeholder.svg'"
      >
    </div>
  </div>

  <div class="detail-info">
    <div class="d-title">
      <div class="title-row">
        <h1>{{ vod.name }}</h1>
        {% if vod.remarks != blank %}<span class="title-badge">{{ vod.remarks }}</span>{% endif %}
      </div>
      {% if vod.sub_name != blank %}<p class="sub-name">{{ vod.sub_name }}</p>{% endif %}
    </div>

    <div class="d-tags">
      {% if vod.category_name != blank %}<span class="cat"><i>分类</i>{{ vod.category_name }}</span>{% endif %}
      <span class="year"><i>年份</i>{{ vod.year }}</span>
      {% if vod.area != blank %}<span class="area"><i>地区</i>{{ vod.area }}</span>{% endif %}
      {% if vod.lang != blank %}<span class="lang"><i>语言</i>{{ vod.lang }}</span>{% endif %}
    </div>

    <dl class="d-fields">
      <div><dt>导演</dt><dd class="line-1">{% if vod.director != blank %}{{ vod.director }}{% else %}—{% endif %}</dd></div>
      <div><dt>编剧</dt><dd class="line-1">{% if vod.writer != blank %}{{ vod.writer }}{% else %}—{% endif %}</dd></div>
      <div><dt>演员</dt><dd>{% if vod.actor != blank %}{{ vod.actor }}{% else %}—{% endif %}</dd></div>
      <div class="wide">
        <dt>简介</dt>
        <dd class="intro-dd">{% if vod.content != blank and vod.content != vod.intro %}{{ vod.intro | slice: 0, 200 | escape }}…<a class="intro-link" href="javascript:void(0)" data-intro-float>详情</a>{% else %}{{ vod.intro | escape }}{% endif %}</dd>
      </div>
    </dl>
    {% if lines.size > 0 %}
    <div class="detail-actions">
      <a class="btn-primary btn-play-inline" href="/play/{{ vod.id }}/{{ lines.first.id }}/1">立即播放</a>
    </div>
    {% endif %}
  </div>
  {% if vod.content != blank and vod.content != vod.intro %}
  <div class="intro-float" data-intro-float-panel>
    <div class="intro-float-hd"><span>剧情简介</span><a class="intro-link" href="javascript:void(0)" data-intro-float>收起</a></div>
    <div class="intro-float-bd">{{ vod.content | escape }}</div>
  </div>
  {% endif %}
</div>

{% if line_tabs.size > 0 %}
<section class="section detail-eps">
  <div class="ep-tabs" role="tablist">
    {% for line in line_tabs %}
    <a class="ep-tab{% if line.id == current_line_id %} is-active{% endif %}" href="{{ line.href }}">{{ line.name }} <span class="count">{{ line.total }}</span></a>
    {% endfor %}
    <button type="button" class="ep-sort" data-ep-sort>正序</button>
  </div>
  <div class="ep-panel is-active">
    {% if episodes.size > 0 %}
    <div class="ep-scroll">
      <div class="episode-grid">
        {% for ep in episodes %}
        <a class="episode-btn" href="/play/{{ vod.id }}/{{ current_line_id }}/{{ ep.index }}" title="{{ ep.name }}">{{ ep.name }}</a>
        {% endfor %}
      </div>
    </div>
    {% else %}
    <p class="empty-tip">该线路暂无剧集</p>
    {% endif %}
  </div>
  {% if page_count > 1 %}
  <div class="ep-pager">
    {% if prev_href != '' %}<a class="pg" href="{{ prev_href }}" rel="prev">‹</a>{% else %}<span class="pg is-off">‹</span>{% endif %}
    {% for item in page_links %}
      {% if item.gap %}
      <span class="gap">…</span>
      {% elsif item.current %}
      <span class="pg is-cur">{{ item.no }}</span>
      {% else %}
      <a class="pg" href="{{ item.href }}">{{ item.no }}</a>
      {% endif %}
    {% endfor %}
    {% if next_href != '' %}<a class="pg" href="{{ next_href }}" rel="next">›</a>{% else %}<span class="pg is-off">›</span>{% endif %}
    <span class="pg-info">第 {{ page }} / {{ page_count }} 页 · 共 {{ page_total }} 集</span>
    <form class="pg-jump" method="get" action="{{ detail_url }}">
      <input type="hidden" name="line" value="{{ current_line_id }}">
      <input type="number" name="page" min="1" max="{{ page_count }}" placeholder="页码" aria-label="跳转到页码">
      <button type="submit">跳转</button>
    </form>
  </div>
  {% endif %}
</section>
{% endif %}
{% endblock %}
