{% layout 'layout' %}
{% block content %}
<nav class="breadcrumb">
  <a href="/">首页</a>
  <span>/</span>
  {% if vod.parent_alias != blank %}
  <a href="/list/{{ vod.parent_alias }}">{{ vod.parent_name }}</a>
  <span>/</span>
  {% endif %}
  {% if vod.parent_alias and vod.category_alias and vod.category_name %}
  <a href="/list/{{ vod.parent_alias }}?type={{ vod.category_alias }}">{{ vod.category_name }}</a>
  {% elsif vod.category_name %}
  <span>{{ vod.category_name }}</span>
  {% endif %}
  <span>{{ vod.name }}</span>
</nav>

<div class="detail-card">
  <div class="detail-cover-wrap">
    <div class="detail-cover">
      {% if vod.cover != blank %}
      <img src="{{ vod.cover }}" alt="{{ vod.name }}">
      {% else %}
      <div class="no-cover big">{{ vod.name | truncate_text: 8 }}</div>
      {% endif %}
    </div>
  </div>

  <div class="detail-info">
    <div class="d-title">
      <div class="title-row">
        <h1>{{ vod.name }}</h1>
        {% if vod.remarks != blank %}<span class="title-badge">{{ vod.remarks }}</span>{% endif %}
        {% if lines.size > 0 %}<a class="btn-primary btn-play-inline" href="/play/{{ vod.id }}/{{ lines.first.id }}/1">立即播放</a>{% endif %}
      </div>
      {% if vod.sub_name != blank %}<p class="sub-name">{{ vod.sub_name }}</p>{% endif %}
    </div>

    <div class="d-tags">
      {% if vod.category_name != blank %}<span class="cat"><i>分类</i>{{ vod.category_name }}</span>{% endif %}
      <span class="year"><i>年份</i>{{ vod.year }}</span>
      {% if vod.area != blank %}<span class="area"><i>地区</i>{{ vod.area }}</span>{% endif %}
      {% if vod.lang != blank %}<span class="lang"><i>语言</i>{{ vod.lang }}</span>{% endif %}
    </div>

    <dl class="d-fields">
      <div><dt>导演</dt><dd>{% if vod.director != blank %}{{ vod.director }}{% else %}—{% endif %}</dd></div>
      <div><dt>编剧</dt><dd>{% if vod.writer != blank %}{{ vod.writer }}{% else %}—{% endif %}</dd></div>
      <div><dt>演员</dt><dd>{% if vod.actor != blank %}{{ vod.actor }}{% else %}—{% endif %}</dd></div>
      <div class="wide"><dt>简介</dt><dd>{% if vod.intro != blank %}{{ vod.intro | escape }}{% else %}—{% endif %}</dd></div>
    </dl>
  </div>
</div>

{% if lines.size > 0 %}
<section class="section detail-eps">
  <h2>播放列表{% if current_line %} <span class="section-count">共 {{ current_line.episode_count }} 集</span>{% endif %}</h2>

  <div class="line-tabs">
    {% for line in lines %}
    <a class="line-tab{% if line.id == current_line.id %} active{% endif %}"
       href="/detail/{{ vod.id }}?line={{ line.id }}">{{ line.name }}
      <span class="count">{{ line.episode_count }}</span>
    </a>
    {% endfor %}
  </div>

  {% if episodes.size > 0 %}
  {% assign play_base = '/play/' | append: vod.id | append: '/' | append: current_line.id %}
  {% assign ep_base = '/detail/' | append: vod.id | append: '?line=' | append: current_line.id %}
  {% render 'partials/episode-list', episodes: episodes, current_ep: 0, play_base: play_base %}

  {% if pagination.total_pages > 1 %}
  <nav class="ep-pager">
    {% if pagination.page > 1 %}
    <a class="ep-page" href="{{ ep_base }}&ep={{ pagination.page | minus: 1 }}">上一页</a>
    {% else %}
    <span class="ep-page disabled">上一页</span>
    {% endif %}
    {% for p in page_numbers %}
    {% if p == 'gap' %}
    <span class="ep-page gap">…</span>
    {% else %}
    <a class="ep-page{% if p == pagination.page %} active{% endif %}" href="{{ ep_base }}&ep={{ p }}">{{ p }}</a>
    {% endif %}
    {% endfor %}
    {% if pagination.page < pagination.total_pages %}
    <a class="ep-page" href="{{ ep_base }}&ep={{ pagination.page | plus: 1 }}">下一页</a>
    {% else %}
    <span class="ep-page disabled">下一页</span>
    {% endif %}
  </nav>
  {% endif %}
  {% else %}
  <p class="empty-tip">该线路还没有剧集</p>
  {% endif %}
</section>
{% endif %}
{% endblock %}
