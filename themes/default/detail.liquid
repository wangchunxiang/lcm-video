{% layout 'layout' %}
{% block content %}

<section class="detail-hero">
  <div class="hero-bg" aria-hidden="true">
    <img
      src="{{ vod.cover | default: '/assets/img/poster-placeholder.svg' }}"
      alt=""
      onerror="this.style.display='none'"
    >
  </div>

  <div class="hero-info">
    <h1 class="hero-title">{{ vod.name }}</h1>
    {% if vod.sub_name != blank %}<p class="hero-sub">{{ vod.sub_name }}</p>{% endif %}

    <div class="hero-tags">
      {% if vod.year > 0 %}<span class="tag tag-year">{{ vod.year }}</span>{% endif %}
      {% if vod.category_name != blank %}<span class="tag">{{ vod.category_name }}</span>{% endif %}
      {% if vod.remarks != blank %}<span class="tag">{{ vod.remarks }}</span>{% endif %}
    </div>

    <div class="hero-meta">
      {% if vod.area != blank %}<span>{{ vod.area }}</span>{% endif %}
      {% if vod.lang != blank %}<span>{{ vod.lang }}</span>{% endif %}
      {% if vod.release_date != blank %}<span>{{ vod.release_date }}</span>{% endif %}
    </div>

    <dl class="hero-fields">
      <div><dt>导演</dt><dd>{% if vod.director != blank %}{{ vod.director }}{% else %}—{% endif %}</dd></div>
      <div><dt>演员</dt><dd>{% if vod.actor != blank %}{{ vod.actor }}{% else %}—{% endif %}</dd></div>
      <div><dt>简介</dt><dd class="hero-intro" data-intro>{% if vod.content != blank %}{{ vod.content | escape }}{% else %}{{ vod.intro | escape }}{% endif %}</dd></div>
    </dl>
    <button type="button" class="intro-toggle" data-intro-toggle>展开</button>

    {% if lines.size > 0 %}
    <div class="hero-actions">
      <a class="btn-primary hero-play" href="/play/{{ vod.id }}/{{ lines.first.id }}/1">立即播放</a>
      <button type="button" class="btn-ghost" data-share>分享</button>
    </div>
    {% endif %}
  </div>
</section>

{% if line_tabs.size > 0 %}
<section class="section detail-eps">
  <div class="ep-tabs" role="tablist">
    {% for line in line_tabs %}
    <a class="ep-tab{% if line.id == current_line_id %} is-active{% endif %}" href="{{ line.href }}">{{ line.name }} <span class="count">{{ line.total }}</span></a>
    {% endfor %}
    <button type="button" class="ep-sort" data-ep-sort>正序</button>
  </div>
  <div class="ep-panel is-active">
    {% if episodes.size > 0 %}
    <div class="ep-scroll">
      <div class="episode-grid">
        {% for ep in episodes %}
        <a class="episode-btn" href="/play/{{ vod.id }}/{{ current_line_id }}/{{ ep.index }}" title="{{ ep.name }}">{{ ep.name }}</a>
        {% endfor %}
      </div>
    </div>
    {% else %}
    <p class="empty-tip">该线路暂无剧集</p>
    {% endif %}
  </div>
</section>
{% endif %}
{% endblock %}
