{% layout 'layout' %}


{% block content %}
<section class="detail-banner">
  <img
    class="banner-pic"
    src="{{ vod.cover | default: '/assets/img/poster-placeholder.svg' }}"
    alt=""
    aria-hidden="true"
    onerror="this.style.display='none'"
  >

  <div class="banner-info">
    <h1 class="banner-title">{{ vod.name }}</h1>
    {% if vod.sub_name != blank %}<p class="banner-sub">{{ vod.sub_name }}</p>{% endif %}

    <div class="banner-tags">
      {% if vod.year > 0 %}<span class="tag tag-year">{{ vod.year }}</span>{% endif %}
      {% if vod.category_name != blank %}<span class="tag">{{ vod.category_name }}</span>{% endif %}
      {% if vod.remarks != blank %}<span class="tag">{{ vod.remarks }}</span>{% endif %}
    </div>

    <dl class="banner-fields">
      <div><dt>导演</dt><dd>{% if vod.director != blank %}{{ vod.director }}{% else %}—{% endif %}</dd></div>
      <div><dt>编剧</dt><dd>{% if vod.writer != blank %}{{ vod.writer }}{% else %}—{% endif %}</dd></div>
      <div><dt>演员</dt><dd>{% if vod.actor != blank %}{{ vod.actor }}{% else %}—{% endif %}</dd></div>
      <div><dt>简介</dt>{% assign intro_text = vod.content | default: vod.intro %}
        <dd class="banner-intro" data-intro>{{ intro_text | escape }}{% if vod.content != blank and vod.content != vod.intro %}<button type="button" class="intro-toggle" data-intro-open>… 详情</button>{% endif %}</dd></div>
    </dl>

    {% if lines.size > 0 %}
    <div class="banner-actions">
      <a class="btn-primary banner-play" href="/play/{{ vod.id }}/{{ lines.first.id }}/1">立即播放</a>
      <div class="qr-pop">
        <button type="button" class="btn-ghost" data-qr aria-describedby="qr-panel">手机观看</button>
        <div class="qr-pop-panel" id="qr-panel" data-qr-panel>
          <div class="qr-code" data-qr-code></div>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</section>




{% if line_tabs.size > 0 %}
<section class="section detail-eps">
  <div class="ep-tabs" role="tablist">
    {% for line in line_tabs %}
    <a class="ep-tab{% if line.id == current_line_id %} is-active{% endif %}" href="{{ line.href }}">{{ line.name }} <span class="count">{{ line.total }}</span></a>
    {% endfor %}
    <button type="button" class="ep-sort" data-ep-sort>正序</button>
  </div>
  <div class="ep-panel is-active">
    {% if episodes.size > 0 %}
    <div class="ep-scroll">
      <div class="episode-grid">
        {% for ep in episodes %}
        <a class="episode-btn" href="/play/{{ vod.id }}/{{ current_line_id }}/{{ ep.index }}" title="{{ ep.name }}">{{ ep.name }}</a>
        {% endfor %}
      </div>
    </div>
    {% else %}
    <p class="empty-tip">该线路暂无剧集</p>
    {% endif %}
  </div>

  <div class="intro-modal" data-intro-modal hidden>
    <div class="intro-modal-card" role="dialog" aria-modal="true" aria-label="剧情简介">
      <div class="intro-modal-hd">
        <h3>{{ vod.name }}</h3>
        <button type="button" class="btn-ghost intro-modal-close" data-intro-close>关闭</button>
      </div>
      <div class="intro-modal-bd">{{ intro_text | escape }}</div>
    </div>
  </div>
</section>
{% endif %}
{% endblock %}
{% block scripts %}<script src="{{ 'vendor/qrcode.min.js' | asset }}"></script>{% endblock %}
