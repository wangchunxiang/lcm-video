{% layout 'layout' %}
{% block content %}
{% assign base = '/search' %}

<div class="list-page">
<nav class="breadcrumb">
  <a href="/">首页</a>
  <span>/</span>
  <span>搜索</span>
  {% if keyword != '' %}
  <span class="bc-extra">「{{ keyword }}」共找到 {{ pagination.total }} 部影片</span>
  {% endif %}
</nav>

{% if keyword == '' %}
<p class="empty-tip">输入片名开始搜索。</p>
{% else %}
{% if years.size > 0 %}
<div class="filter-block">
  <div class="filter-row">
    <span class="filter-label">年份</span>
    {% assign fy_all = filter | with_year: '' %}
    <a class="filter-item{% if filter.year == '' %} active{% endif %}" href="{{ base | page_url: fy_all, 1 }}">全部</a>
    {% for y in years %}
    {% assign fy = filter | with_year: y %}
    <a class="filter-item{% if filter.year == y %} active{% endif %}" href="{{ base | page_url: fy, 1 }}">{{ y }}</a>
    {% endfor %}
  </div>

  <div class="filter-row">
    <span class="filter-label">排序</span>
    {% assign fs_time = filter | with_sort: 'time' %}
    {% assign fs_new = filter | with_sort: 'new' %}
    <a class="filter-item{% if filter.sort == 'time' %} active{% endif %}" href="{{ base | page_url: fs_time, 1 }}">最近更新</a>
    <a class="filter-item{% if filter.sort == 'new' %} active{% endif %}" href="{{ base | page_url: fs_new, 1 }}">最新入库</a>
  </div>
</div>
{% endif %}

<div class="vod-grid">
  {% for v in vods %}
  {% render 'partials/vod-card', card: v %}
  {% else %}
  <p class="empty-tip">没有找到「{{ keyword }}」，换个关键词试试。</p>
  {% endfor %}
</div>

{% render 'partials/pagination', pagination: pagination, base: base, filter: filter %}
{% endif %}
</div>
{% endblock %}
