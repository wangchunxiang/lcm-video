{% layout 'layout' %}
{% block content %}
{% assign base = '/search' %}

<nav class="breadcrumb">
  <a href="/">首页</a>
  <span>/</span>
  <span>搜索</span>
</nav>

{% if keyword == '' %}
<p class="empty-tip">请在顶部搜索框输入片名。</p>
{% else %}
<p class="search-summary">「{{ keyword }}」共找到 {{ pagination.total }} 部影片</p>

<div class="vod-grid">
  {% for v in vods %}
  {% render 'partials/vod-card', card: v %}
  {% else %}
  <p class="empty-tip">没有找到与「{{ keyword }}」相关的影片，换个关键词试试。</p>
  {% endfor %}
</div>

{% render 'partials/pagination', pagination: pagination, base: base, filter: filter %}
{% endif %}
{% endblock %}
