{
  "name": "@lcm/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:init": "node --env-file-if-exists=../../.env --import tsx src/database/init-db.ts",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx src/database/seed.ts"
  },
  "dependencies": {
    "@ackplus/nest-crud": "^2.5.2",
    "@lcm/shared": "*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "nestjs-pino": "^4.4.1",
    "p-limit": "^3.1.0",
    "pino": "^10.4.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15"
  }
}
